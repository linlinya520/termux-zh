#!/data/data/com.termux/files/usr/bin/bash

# 绿色输出
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

# 中文帮助
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo -e "${YELLOW}命令：执行${RESET}"
  echo -e "${YELLOW}用法示例：执行 ~/termux-zh/uninstall.sh${RESET}"
  echo -e "${YELLOW}说明：执行指定脚本文件，可带参数${RESET}"
  exit 0
fi

SCRIPT="$1"
shift

if [ -z "$SCRIPT" ]; then
    echo -e "${RED}错误: 请输入脚本路径${RESET}"
    exit 1
fi

if [ ! -f "$SCRIPT" ]; then
    echo -e "${RED}错误: 文件不存在 -> $SCRIPT${RESET}"
    exit 1
fi

# 给脚本加可执行权限
chmod +x "$SCRIPT" 2>/dev/null

# 最后一行：底层执行命令，供中英对照表扫描
bash "$SCRIPT" "$@"